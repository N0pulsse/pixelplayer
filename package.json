{
  "name": "pixelplayer",
  "productName": "Pixel Player",
  "version": "2.0.0",
  "description": "Музыкальный плеер для Windows в стиле Material 3 Expressive: автопоиск музыки, динамические цвета из обложек, тексты песен, анимации",
  "author": "Pixel Player",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "watch": "node scripts/build.mjs --watch",
    "dist": "npm run dist:portable",
    "dist:portable": "node scripts/build.mjs && electron-builder --win portable --x64",
    "dist:installer": "node scripts/build.mjs && electron-builder --win nsis --x64",
    "dist:dir": "node scripts/build.mjs && electron-builder --win dir",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "music-metadata": "^11.0.0"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.pixelplayer.desktop",
    "productName": "Pixel Player",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "build/icon.png",
      "LICENSE",
      "licenses/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "flac",
            "m4a",
            "aac",
            "ogg",
            "opus",
            "wav"
          ],
          "name": "Аудиофайл",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Player"
    },
    "portable": {
      "artifactName": "PixelPlayer-portable-${version}-x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
